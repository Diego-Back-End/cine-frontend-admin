# =========================================
# Configuración Microsoft Entra ID (SSO)
# =========================================

# Application (client) ID de tu App Registration en Entra ID
VITE_AZURE_CLIENT_ID=

# Directory (tenant) ID - solo el GUID, sin la URL completa
# Ej: 6f2fd1b2-9a3c-4d5e-8f01-123456789abc
VITE_AZURE_AUTHORITY=

# URL de retorno post-login (debe coincidir con la Redirect URI registrada en Azure)
# Ej: http://localhost:5173
VITE_AZURE_REDIRECT_URI=

# Scope OAuth2 para el access token
VITE_AZURE_SCOPE=User.Read

# =========================================
# Roles en Azure Entra ID
# =========================================
# Si ambos valores están vacíos, se activa el MODO DESARROLLO:
# cualquier usuario autenticado con Microsoft podrá acceder como SUPER_ADMIN.
# Esto sirve para probar la app sin configurar grupos/roles en Azure.

# Object ID del grupo (o valor del rol) que identifica al Super Administrador
VITE_SUPER_ADMIN_ROLE_ID=

# Object ID del grupo (o valor del rol) que identifica al Administrador de Sucursal
VITE_BRANCH_ADMIN_ROLE_ID=

# =========================================
# Backend Catalogo (conexión directa sin Gateway para MVP local)
# =========================================
VITE_CATALOGO_API_URL=http://localhost:8081/api